            &lt;div class="exe-text-activity"&gt;
                &lt;div&gt;&lt;div class="exe-text"&gt;
&lt;p&gt;&lt;img src="{{context_path}}/20251125073130XMKZTE/img0.png" width="361" height="542" alt="Ada Lovelace" style="display: block; margin-left: auto; margin-right: auto;"&gt;&lt;/p&gt;
&lt;p data-start="89" data-end="204"&gt;&lt;span style="font-size: 14pt;"&gt;Almost 200 years ago, &lt;strong data-start="111" data-end="127"&gt;Ada Lovelace&lt;/strong&gt; wrote the world’s &lt;strong data-start="146" data-end="172"&gt;first computer program&lt;/strong&gt;… even before computers existed!&lt;/span&gt;&lt;/p&gt;
&lt;p data-start="206" data-end="288"&gt;&lt;span style="font-size: 14pt;"&gt;She imagined machines capable of discovering &lt;strong data-start="251" data-end="270"&gt;hidden patterns&lt;/strong&gt; from &lt;strong data-start="276" data-end="287"&gt;numbers&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;&lt;p class="clearfix"&gt;&lt;/p&gt;&lt;/div&gt;
            &lt;/div&gt;&lt;/div&gt;&lt;/div&gt;</htmlView><jsonProperties>{"ideviceId":"20251125073130XMKZTE","textInfoDurationInput":"","textInfoDurationTextInput":"Duración","textInfoParticipantsInput":"","textInfoParticipantsTextInput":"Agrupamiento","textTextarea":"&lt;div class=\"exe-text\"&gt;\n&lt;p&gt;&lt;img src=\"{{context_path}}/20251125073130XMKZTE/img0.png\" width=\"361\" height=\"542\" alt=\"Ada Lovelace\" style=\"display: block; margin-left: auto; margin-right: auto;\" /&gt;&lt;/p&gt;\n&lt;p data-start=\"89\" data-end=\"204\"&gt;&lt;span style=\"font-size: 14pt;\"&gt;Almost 200 years ago, &lt;strong data-start=\"111\" data-end=\"127\"&gt;Ada Lovelace&lt;/strong&gt; wrote the world’s &lt;strong data-start=\"146\" data-end=\"172\"&gt;first computer program&lt;/strong&gt;… even before computers existed!&lt;/span&gt;&lt;/p&gt;\n&lt;p data-start=\"206\" data-end=\"288\"&gt;&lt;span style=\"font-size: 14pt;\"&gt;She imagined machines capable of discovering &lt;strong data-start=\"251\" data-end=\"270\"&gt;hidden patterns&lt;/strong&gt; from &lt;strong data-start=\"276\" data-end=\"287\"&gt;numbers&lt;/strong&gt;.&lt;/span&gt;&lt;/p&gt;\n&lt;/div&gt;","textFeedbackInput":"Mostrar retroalimentación","textFeedbackTextarea":""}</jsonProperties><odeComponentsOrder>1</odeComponentsOrder><odeComponentsProperties><odeComponentsProperty><key>visibility</key><value>true</value></odeComponentsProperty><odeComponentsProperty><key>teacherOnly</key><value>false</value></odeComponentsProperty><odeComponentsProperty><key>identifier</key><value/></odeComponentsProperty><odeComponentsProperty><key>cssClass</key><value/></odeComponentsProperty></odeComponentsProperties></odeComponent></odeComponents></odePagStructure></odePagStructures></odeNavStructure><odeNavStructure><odePageId>20251212104344LQLFIT</odePageId><odeParentPageId/><pageName>WORK LIKE ADA LOVELACE</pageName><odeNavStructureOrder>3</odeNavStructureOrder><odeNavStructureProperties><odeNavStructureProperty><key>titlePage</key><value>WORK LIKE ADA LOVELACE</value></odeNavStructureProperty><odeNavStructureProperty><key>titleNode</key><value>WORK LIKE ADA LOVELACE</value></odeNavStructureProperty><odeNavStructureProperty><key>hidePageTitle</key><value>false</value></odeNavStructureProperty><odeNavStructureProperty><key>titleHtml</key><value/></odeNavStructureProperty><odeNavStructureProperty><key>editableInPage</key><value>false</value></odeNavStructureProperty><odeNavStructureProperty><key>visibility</key><value>true</value></odeNavStructureProperty><odeNavStructureProperty><key>highlight</key><value>false</value></odeNavStructureProperty><odeNavStructureProperty><key>description</key><value/></odeNavStructureProperty></odeNavStructureProperties><odePagStructures><odePagStructure><odePageId>20251212104344LQLFIT</odePageId><odeBlockId>20251212104344UYQYEU</odeBlockId><blockName/><iconName/><odePagStructureOrder>10</odePagStructureOrder><odePagStructureProperties><odePagStructureProperty><key>visibility</key><value>true</value></odePagStructureProperty><odePagStructureProperty><key>teacherOnly</key><value>false</value></odePagStructureProperty><odePagStructureProperty><key>allowToggle</key><value>true</value></odePagStructureProperty><odePagStructureProperty><key>minimized</key><value>false</value></odePagStructureProperty><odePagStructureProperty><key>identifier</key><value/></odePagStructureProperty><odePagStructureProperty><key>cssClass</key><value/></odePagStructureProperty></odePagStructureProperties><odeComponents><odeComponent><odePageId>20251212104344LQLFIT</odePageId><odeBlockId>20251212104344UYQYEU</odeBlockId><odeIdeviceId>20251125073130EABSKG</odeIdeviceId><odeIdeviceTypeName>udl-content</odeIdeviceTypeName><htmlView>&lt;div class="exe-udlContent exe-udlContent-engagement"&gt;&lt;section class="exe-udlContent-block"&gt;&lt;div class="exe-udlContent-content"&gt;&lt;div class="exe-udlContent-content-main"&gt;&lt;p data-start="125" data-end="347"&gt;Today we will follow in the footsteps of &lt;strong data-start="166" data-end="182"&gt;Ada Lovelace&lt;/strong&gt; using our own pocket-sized computer: the &lt;strong data-start="224" data-end="237"&gt;micro:bit&lt;/strong&gt;. We will program it to measure how the &lt;strong data-start="277" data-end="296"&gt;amount of light&lt;/strong&gt; detected decreases as the &lt;strong data-start="323" data-end="346"&gt;Moon covers the Sun&lt;/strong&gt;.&lt;/p&gt;
&lt;p data-start="349" data-end="607"&gt;When the &lt;strong data-start="358" data-end="375"&gt;solar eclipse&lt;/strong&gt; arrives, your micro:bit will become a &lt;strong data-start="414" data-end="434"&gt;mini-observatory&lt;/strong&gt;, recording &lt;strong data-start="446" data-end="459"&gt;real data&lt;/strong&gt; every few seconds. Afterwards, we will create &lt;strong data-start="506" data-end="516"&gt;graphs&lt;/strong&gt; with the results and identify the &lt;strong data-start="551" data-end="579"&gt;exact moment of totality&lt;/strong&gt;, just like real scientists.&lt;/p&gt;
&lt;table style="border-style: double; border-color: #c8c8c8; height: 5650.07px; width: 862px;"&gt;
&lt;tbody&gt;
&lt;tr style="height: 76px;"&gt;
&lt;td colspan="3" style="width: 861.334px; height: 76px; border: 1px solid #c8c8c8;"&gt;
&lt;h2&gt;&lt;strong&gt;STEP 1 – Set up MakeCode&lt;/strong&gt;&lt;/h2&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 367.073px;"&gt;
&lt;td style="width: 138.969px; height: 367.073px; border: 1px solid #c8c8c8;"&gt;
&lt;ol&gt;
&lt;li data-start="80" data-end="152"&gt;
&lt;p data-start="83" data-end="152"&gt;Connect your &lt;strong data-start="96" data-end="109"&gt;micro:bit&lt;/strong&gt; to the computer using the &lt;strong data-start="136" data-end="149"&gt;USB cable&lt;/strong&gt;.&lt;/p&gt;
&lt;/li&gt;
&lt;li data-start="153" data-end="199" data-is-last-node=""&gt;
&lt;p data-start="156" data-end="199" data-is-last-node=""&gt;Open the &lt;a href="https://makecode.microbit.org/" target="_blank" rel="noopener"&gt;&lt;strong data-start="165" data-end="177" id="link_1"&gt;MakeCode&lt;/strong&gt;&lt;/a&gt; editor for micro:bit.&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;/td&gt;
&lt;td colspan="2" style="width: 722.365px; height: 367.073px; border: 1px solid #c8c8c8;"&gt;&lt;img src="{{context_path}}/20251125073130EABSKG/mceclip11.png"&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 76px;"&gt;
&lt;td colspan="3" style="width: 861.334px; height: 76px; border: 1px solid #c8c8c8;"&gt;
&lt;h2&gt;&lt;strong&gt;STEP 2 – Add the &lt;em data-start="23" data-end="36"&gt;Data Logger&lt;/em&gt; extension&lt;/strong&gt;&lt;/h2&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 567px;"&gt;
&lt;td style="width: 138.969px; height: 567px; border: 1px solid #c8c8c8;"&gt;
&lt;ol&gt;
&lt;li data-start="217" data-end="276"&gt;
&lt;p data-start="220" data-end="276"&gt;In the block palette, go to &lt;strong data-start="248" data-end="273"&gt;Advanced → Extensions&lt;/strong&gt;.&lt;/p&gt;
&lt;/li&gt;
&lt;li data-start="277" data-end="341"&gt;
&lt;p data-start="280" data-end="341"&gt;In the search bar, type &lt;strong data-start="304" data-end="318"&gt;datalogger&lt;/strong&gt; and click to add it.&lt;/p&gt;
&lt;/li&gt;
&lt;li data-start="342" data-end="424"&gt;
&lt;p data-start="345" data-end="424"&gt;A new menu called &lt;strong data-start="363" data-end="378"&gt;Data Logger&lt;/strong&gt; will appear in the block palette on the left.&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;/td&gt;
&lt;td style="width: 198.521px; height: 567px; border: 1px solid #c8c8c8;"&gt;&lt;img src="{{context_path}}/20251125073130EABSKG/mceclip12.png"&gt;&lt;/td&gt;
&lt;td style="width: 523.844px; height: 567px; border: 1px solid #c8c8c8;"&gt;&lt;img src="{{context_path}}/20251125073130EABSKG/mceclip13.png"&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 76px;"&gt;
&lt;td colspan="3" style="width: 861.334px; height: 76px; border: 1px solid #c8c8c8;"&gt;
&lt;h2&gt;&lt;strong&gt;STEP 3 – Create the &lt;em data-start="26" data-end="33"&gt;light&lt;/em&gt; variable&lt;/strong&gt;&lt;/h2&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 557px;"&gt;
&lt;td style="width: 138.969px; height: 557px; border: 1px solid #c8c8c8;"&gt;
&lt;ol&gt;
&lt;li data-start="185" data-end="244"&gt;
&lt;p data-start="188" data-end="244"&gt;Go to the &lt;strong data-start="198" data-end="211"&gt;Variables&lt;/strong&gt; category in the block palette.&lt;/p&gt;
&lt;/li&gt;
&lt;li data-start="245" data-end="280"&gt;
&lt;p data-start="248" data-end="280"&gt;Click &lt;strong data-start="254" data-end="278"&gt;“Create a variable…”&lt;/strong&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li data-start="281" data-end="322"&gt;
&lt;p data-start="284" data-end="322"&gt;Type the name &lt;strong data-start="298" data-end="307"&gt;light&lt;/strong&gt; and confirm.&lt;/p&gt;
&lt;/li&gt;
&lt;li data-start="323" data-end="415"&gt;
&lt;p data-start="326" data-end="415"&gt;You will now have blocks such as &lt;strong data-start="359" data-end="376"&gt;set light to…&lt;/strong&gt; and &lt;strong data-start="381" data-end="404"&gt;show number (light)&lt;/strong&gt; available.&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;/td&gt;
&lt;td style="width: 198.521px; height: 557px; border: 1px solid #c8c8c8;"&gt;&lt;img src="{{context_path}}/20251125073130EABSKG/mceclip14.png"&gt;&lt;/td&gt;
&lt;td style="width: 523.844px; height: 557px; border: 1px solid #c8c8c8;"&gt;&lt;img src="{{context_path}}/20251125073130EABSKG/mceclip15.png"&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 76px;"&gt;
&lt;td colspan="3" style="width: 861.334px; height: 76px; border: 1px solid #c8c8c8;"&gt;
&lt;h2&gt;&lt;strong&gt;STEP 4 – The “on start” block&lt;/strong&gt;&lt;/h2&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 248px;"&gt;
&lt;td style="width: 138.969px; height: 248px; border: 1px solid #c8c8c8;"&gt;&lt;strong data-start="0" data-end="7" data-is-only-node=""&gt;4.1&lt;/strong&gt; – In &lt;strong data-start="13" data-end="22"&gt;Basic&lt;/strong&gt;, drag the &lt;strong data-start="33" data-end="47"&gt;“on start”&lt;/strong&gt; block.&lt;/td&gt;
&lt;td style="width: 198.521px; height: 248px; border: 1px solid #c8c8c8;"&gt;&lt;img src="{{context_path}}/20251125073130EABSKG/mceclip17.png"&gt;&lt;/td&gt;
&lt;td style="width: 523.844px; height: 248px; border: 1px solid #c8c8c8;"&gt;&lt;img src="{{context_path}}/20251125073130EABSKG/mceclip18.png" class="position-center"&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 258px;"&gt;
&lt;td style="width: 138.969px; height: 258px; border: 1px solid #c8c8c8;"&gt;&lt;strong data-start="139" data-end="146"&gt;4.2&lt;/strong&gt; – Inside it, place the &lt;strong data-start="170" data-end="187"&gt;“set columns”&lt;/strong&gt; block from &lt;strong data-start="199" data-end="214"&gt;Data Logger&lt;/strong&gt; and type &lt;strong data-start="224" data-end="235"&gt;“light”&lt;/strong&gt;.&lt;/td&gt;
&lt;td style="width: 198.521px; height: 258px; border: 1px solid #c8c8c8;"&gt;&lt;img src="{{context_path}}/20251125073130EABSKG/mceclip16.png"&gt;&lt;/td&gt;
&lt;td style="width: 523.844px; height: 258px; border: 1px solid #c8c8c8;"&gt;&lt;img src="{{context_path}}/20251125073130EABSKG/mceclip19.png"&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 76px;"&gt;
&lt;td colspan="3" style="width: 861.334px; height: 76px; border: 1px solid #c8c8c8;"&gt;
&lt;h2&gt;&lt;strong&gt; STEP 5 – The “forever” block&lt;/strong&gt;&lt;/h2&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 269px;"&gt;
&lt;td style="width: 138.969px; height: 269px; border: 1px solid #c8c8c8;"&gt;
&lt;p&gt;&lt;strong data-start="0" data-end="7" data-is-only-node=""&gt;5.1&lt;/strong&gt; – In &lt;strong data-start="13" data-end="22"&gt;Basic&lt;/strong&gt;, drag the &lt;strong data-start="33" data-end="46"&gt;“forever”&lt;/strong&gt; block..&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 198.521px; height: 269px; border: 1px solid #c8c8c8;"&gt;&lt;img src="{{context_path}}/20251125073130EABSKG/mceclip9.png"&gt;&lt;/td&gt;
&lt;td style="width: 523.844px; height: 269px; border: 1px solid #c8c8c8;"&gt;&lt;img src="{{context_path}}/20251125073130EABSKG/mceclip10.png" class="position-center"&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 562.667px;"&gt;
&lt;td style="width: 138.969px; height: 562.667px; border: 1px solid #c8c8c8;"&gt;
&lt;p data-start="131" data-end="156"&gt;&lt;strong data-start="131" data-end="156"&gt;5.2 – Inside it, add:&lt;/strong&gt;&lt;/p&gt;
&lt;ol data-start="158" data-end="388"&gt;
&lt;li data-start="158" data-end="241"&gt;
&lt;p data-start="161" data-end="241"&gt;&lt;strong data-start="161" data-end="189"&gt;Variables → set light to&lt;/strong&gt; → place inside the block &lt;strong data-start="215" data-end="238"&gt;Input → light level&lt;/strong&gt;.&lt;/p&gt;
&lt;/li&gt;
&lt;li data-start="242" data-end="304"&gt;
&lt;p data-start="245" data-end="304"&gt;&lt;strong data-start="245" data-end="272"&gt;Data Logger → log value&lt;/strong&gt; with key &lt;strong data-start="282" data-end="301"&gt;“light” = light&lt;/strong&gt;.&lt;/p&gt;
&lt;/li&gt;
&lt;li data-start="305" data-end="342"&gt;
&lt;p data-start="308" data-end="342"&gt;&lt;strong data-start="308" data-end="339"&gt;Basic → show number (light)&lt;/strong&gt;.&lt;/p&gt;
&lt;/li&gt;
&lt;li data-start="343" data-end="388"&gt;
&lt;p data-start="346" data-end="388"&gt;&lt;strong data-start="346" data-end="375"&gt;Basic → pause (ms) = 5000&lt;/strong&gt; (5 seconds).&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;/td&gt;
&lt;td style="width: 198.521px; height: 562.667px; border: 1px solid #c8c8c8;"&gt;&lt;img src="{{context_path}}/20251125073130EABSKG/mceclip20.png"&gt;&lt;/td&gt;
&lt;td style="width: 523.844px; height: 562.667px; border: 1px solid #c8c8c8;"&gt;&lt;img src="{{context_path}}/20251125073130EABSKG/mceclip21.png"&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 76px;"&gt;
&lt;td style="width: 861.334px; height: 76px; border: 1px solid #c8c8c8;" colspan="3"&gt;
&lt;h2&gt;&lt;strong&gt;STEP 6 – Download the program&lt;/strong&gt;&lt;strong&gt;&lt;/strong&gt;&lt;/h2&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 114px;"&gt;
&lt;td style="width: 138.969px; height: 114px; border: 1px solid #c8c8c8;"&gt;
&lt;p&gt;Click &lt;strong data-start="6" data-end="18"&gt;Download&lt;/strong&gt; in MakeCode.&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 722.365px; height: 114px; border: 1px solid #c8c8c8;" colspan="2"&gt;&lt;img src="{{context_path}}/20251125073130EABSKG/mceclip22.png"&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 76px;"&gt;
&lt;td style="width: 861.334px; height: 76px; border: 1px solid #c8c8c8;" colspan="3"&gt;
&lt;h2&gt;&lt;strong&gt;STEP 7 – Simulate the eclipse&lt;/strong&gt;&lt;/h2&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 578.667px;"&gt;
&lt;td style="width: 138.969px; height: 578.667px; border: 1px solid #c8c8c8;"&gt;
&lt;ol&gt;
&lt;li data-start="87" data-end="172"&gt;
&lt;p data-start="90" data-end="172"&gt;Disconnect the &lt;strong data-start="105" data-end="118"&gt;micro:bit&lt;/strong&gt; from the computer and connect the &lt;strong data-start="153" data-end="169"&gt;battery pack&lt;/strong&gt;.&lt;/p&gt;
&lt;/li&gt;
&lt;li data-start="173" data-end="271"&gt;
&lt;p data-start="176" data-end="271"&gt;Using a &lt;strong data-start="184" data-end="198"&gt;flashlight&lt;/strong&gt;, cover and uncover the light as if the &lt;strong data-start="238" data-end="268"&gt;Moon were covering the Sun&lt;/strong&gt;.&lt;/p&gt;
&lt;/li&gt;
&lt;li data-start="272" data-end="392"&gt;
&lt;p data-start="275" data-end="392"&gt;Every &lt;strong data-start="281" data-end="294"&gt;5 seconds&lt;/strong&gt;, the micro:bit will display the &lt;strong data-start="327" data-end="342"&gt;light level&lt;/strong&gt; on its screen and save it in the &lt;strong data-start="376" data-end="386"&gt;MYDATA&lt;/strong&gt; file.&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;/td&gt;
&lt;td style="height: 578.667px; width: 722.365px; border: 1px solid #c8c8c8;" colspan="2"&gt;&lt;img src="{{context_path}}/20251125073130EABSKG/img14.1.png" width="729" height="410" alt=""&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 71px;"&gt;
&lt;td style="width: 861.334px; height: 71px; border: 1px solid #c8c8c8;" colspan="3"&gt;
&lt;h2&gt;&lt;strong&gt;STEP 8 – Analyze the data&lt;/strong&gt;&lt;/h2&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 1010.67px;"&gt;
&lt;td style="width: 138.969px; height: 1010.67px; border: 1px solid #c8c8c8;"&gt;
&lt;ol&gt;
&lt;li data-start="85" data-end="134"&gt;
&lt;p data-start="88" data-end="134"&gt;Reconnect the &lt;strong data-start="102" data-end="115"&gt;micro:bit&lt;/strong&gt; to the computer.&lt;/p&gt;
&lt;/li&gt;
&lt;li data-start="135" data-end="200"&gt;
&lt;p data-start="138" data-end="200"&gt;Open the &lt;strong data-start="147" data-end="159"&gt;MICROBIT&lt;/strong&gt; folder and locate the &lt;strong data-start="182" data-end="192"&gt;MYDATA&lt;/strong&gt; file.&lt;/p&gt;
&lt;/li&gt;
&lt;li data-start="201" data-end="297"&gt;
&lt;p data-start="204" data-end="297"&gt;You will see a table with the &lt;strong data-start="234" data-end="243"&gt;light&lt;/strong&gt; column and the values recorded every &lt;strong data-start="281" data-end="294"&gt;2 seconds&lt;/strong&gt;.&lt;/p&gt;
&lt;/li&gt;
&lt;li data-start="298" data-end="452"&gt;
&lt;p data-start="301" data-end="452"&gt;Create a &lt;strong data-start="310" data-end="328"&gt;time vs. light&lt;/strong&gt; graph: you will see how the values &lt;strong data-start="364" data-end="372"&gt;drop&lt;/strong&gt; when you block the light (a valley) and &lt;strong data-start="413" data-end="421"&gt;rise&lt;/strong&gt; when the flashlight returns.&lt;/p&gt;
&lt;/li&gt;
&lt;li data-start="453" data-end="511"&gt;
&lt;p data-start="456" data-end="511"&gt;Try using a &lt;strong data-start="468" data-end="486"&gt;different lamp&lt;/strong&gt; and compare the graph.&lt;/p&gt;
&lt;/li&gt;
&lt;li data-start="512" data-end="607"&gt;
&lt;p data-start="515" data-end="607"&gt;If you have extra time, add a &lt;strong data-start="545" data-end="554"&gt;sound&lt;/strong&gt; to occur when the “eclipse” happens (&lt;strong data-start="592" data-end="605"&gt;light = 0&lt;/strong&gt;).&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;/td&gt;
&lt;td style="height: 1010.67px; border: 1px solid #c8c8c8; width: 722.365px;" colspan="2"&gt;&lt;img src="{{context_path}}/20251125073130EABSKG/img15.png" width="729" height="153" alt=""&gt;&lt;br&gt;&lt;img src="{{context_path}}/20251125073130EABSKG/img16.png" width="176" height="517" alt=""&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 50.6667px;"&gt;
&lt;td style="border: 1px solid #c8c8c8; height: 50.6667px; width: 861.334px;" colspan="3"&gt;💡 &lt;strong data-start="88" data-end="96"&gt;Tip:&lt;/strong&gt; You can use a &lt;strong data-start="111" data-end="126"&gt;spreadsheet&lt;/strong&gt; (for example, Excel, Google Sheets, or Calc) to process the data and create the graphs easily.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 464.323px;"&gt;
&lt;td style="width: 861.334px; border: 1px solid #c8c8c8; height: 464.323px;" colspan="3"&gt;&lt;img src="{{context_path}}/20251125073130EABSKG/LibreOffice-Calc.png" alt="" width="1368" height="727"&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;&lt;/div&gt;</htmlView><jsonProperties>{"ideviceId":"20251125073130EABSKG","textInfoDurationInput":"","textInfoParticipantsInput":"","textInfoDurationTextInput":"","textInfoParticipantsTextInput":"","textTextarea":"&lt;div class=\"exe-udlContent exe-udlContent-engagement\"&gt;&lt;section class=\"exe-udlContent-block\"&gt;&lt;div class=\"exe-udlContent-content\"&gt;&lt;div class=\"exe-udlContent-content-main\"&gt;&lt;p&gt;Hoy seguiremos &lt;strong&gt;los pasos de Ada Lovelace&lt;/strong&gt; con nuestro &lt;strong&gt;propio ordenador de bolsillo: el micro:bit.&lt;/strong&gt; Lo programaremos para comprobar c\u00f3mo la cantidad de luz recibida por el detector disminuye cuando la Luna cubre al Sol.&lt;/p&gt;\n&lt;p&gt;Cuando llegue el eclipse e Sol , tu micro:bit ser\u00e1 un mini observatorio, guardando datos reales cada pocos segundos. Despu\u00e9s haremos gr\u00e1ficas con los resultados y encontraremos el momento exacto de la totalidad, como aut\u00e9ntic@s cient\u00edfic@s.&lt;/p&gt;\n&lt;table style=\"border-style: double; border-color: #c8c8c8; height: 5022px; width: 862px;\"&gt;\n&lt;tbody&gt;\n&lt;tr style=\"height: 76px;\"&gt;\n&lt;td colspan=\"3\" style=\"border-style: double; border-color: #c8c8c8; width: 853.333px; height: 76px;\"&gt;\n&lt;h2&gt;&lt;strong&gt;PASO 1 \u2013 Preparar MakeCode&lt;/strong&gt;&lt;/h2&gt;\n&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 357px;\"&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 136.823px; height: 357px;\"&gt;\n&lt;p&gt;&lt;strong&gt;1-&lt;/strong&gt; Conecta tu &lt;strong&gt;micro:bit&lt;/strong&gt; al ordenador con el cable USB.&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;2-&lt;/strong&gt; Abre el editor &lt;span&gt;&lt;a href=\"https://makecode.microbit.org/\"&gt;&lt;strong&gt;MakeCode micro:bit&lt;/strong&gt;.&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;&amp;nbsp;&lt;/strong&gt;&lt;/p&gt;\n&lt;/td&gt;\n&lt;td colspan=\"2\" style=\"border-style: double; border-color: #c8c8c8; width: 711.177px; height: 357px;\"&gt;&lt;strong&gt;&lt;img src=\"{{context_path}}/20251125073130EABSKG/img0.2.png\" width=\"813\" height=\"399\" alt=\"\" style=\"display: block; margin-left: auto; margin-right: auto;\"&gt;&lt;/strong&gt;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 76px;\"&gt;\n&lt;td colspan=\"3\" style=\"border-style: double; border-color: #c8c8c8; width: 853.333px; height: 76px;\"&gt;\n&lt;h2&gt;&lt;strong&gt;PASO 2 \u2013 A\u00f1adir la extensi\u00f3n Data Logger&lt;/strong&gt;&lt;/h2&gt;\n&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 567px;\"&gt;\n&lt;td style=\"width: 136.823px; height: 567px;\"&gt;\n&lt;p&gt;&lt;strong&gt;1-&lt;/strong&gt; En la paleta de bloques, ve a &lt;strong&gt;Avanzado \u2192 Extensiones&lt;/strong&gt;.&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;2-&lt;/strong&gt; En la barra de b\u00fasqueda escribe &lt;strong&gt;datalogger&lt;/strong&gt; y haz clic para a\u00f1adirla.&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;3-&lt;/strong&gt; Ver\u00e1s que aparece un nuevo men\u00fa llamado &lt;strong&gt;Registrador de datos&lt;/strong&gt; en la paleta de bloques (a la izquierda).&lt;/p&gt;\n&lt;/td&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 193.99px; height: 567px;\"&gt;&lt;strong&gt;&lt;img src=\"{{context_path}}/20251125073130EABSKG/img1.png\" width=\"202\" height=\"331\" alt=\"\" style=\"display: block; margin-left: auto; margin-right: auto;\"&gt;&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 511.854px; height: 567px;\"&gt;&lt;strong&gt;&lt;img src=\"{{context_path}}/20251125073130EABSKG/img2.png\" width=\"289\" height=\"324\" alt=\"\" style=\"display: block; margin-left: auto; margin-right: auto;\"&gt;&lt;/strong&gt;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 76px;\"&gt;\n&lt;td colspan=\"3\" style=\"border-style: double; border-color: #c8c8c8; width: 853.333px; height: 76px;\"&gt;\n&lt;h2&gt;&lt;strong&gt;PASO 3 \u2013 Crear la variable luz&amp;nbsp;&lt;/strong&gt;&lt;/h2&gt;\n&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 557px;\"&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 136.823px; height: 557px;\"&gt;\n&lt;p&gt;&lt;strong&gt;1-&lt;/strong&gt; Entra en la categor\u00eda &lt;strong&gt;Variables&lt;/strong&gt; (en la paleta de bloques).&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;2-&lt;/strong&gt; Haz clic en &lt;strong&gt;\u201cCrear una variable\u2026\u201d&lt;/strong&gt;.&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;3-&lt;/strong&gt; Escribe el nombre &lt;strong&gt;luz&lt;/strong&gt; y confirma.&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;4-&lt;/strong&gt; Ahora tendr\u00e1s disponibles bloques como &lt;strong&gt;poner luz a\u2026&lt;/strong&gt; y &lt;strong&gt;mostrar n\u00famero (luz)&lt;/strong&gt;.&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;&amp;nbsp;&lt;/strong&gt;&lt;/p&gt;\n&lt;/td&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 193.99px; height: 557px;\"&gt;&lt;img src=\"{{context_path}}/20251125073130EABSKG/img3.png\" width=\"232\" height=\"299\" alt=\"\" style=\"display: block; margin-left: auto; margin-right: auto;\"&gt;&lt;/td&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 511.854px; height: 557px;\"&gt;&lt;img src=\"{{context_path}}/20251125073130EABSKG/img13.png\"&gt;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 76px;\"&gt;\n&lt;td colspan=\"3\" style=\"border-style: double; border-color: #c8c8c8; width: 853.333px; height: 76px;\"&gt;\n&lt;h2&gt;&lt;strong&gt;PASO 4 \u2013 Bloque \u201cal iniciar\u201d&lt;/strong&gt;&lt;/h2&gt;\n&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 248px;\"&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 136.823px; height: 248px;\"&gt;\n&lt;p&gt;&lt;strong&gt;4.1-&lt;/strong&gt; En &lt;strong&gt;B\u00e1sico&lt;/strong&gt;, arrastra el bloque &lt;strong&gt;\u201cal iniciar\u201d&lt;/strong&gt;.&lt;/p&gt;\n&lt;/td&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 193.99px; height: 248px;\"&gt;&lt;img src=\"{{context_path}}/20251125073130EABSKG/img5.png\" width=\"232\" height=\"262\" alt=\"\" style=\"display: block; margin-left: auto; margin-right: auto;\"&gt;&lt;/td&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 511.854px; height: 248px;\"&gt;&lt;img src=\"{{context_path}}/20251125073130EABSKG/img6.png\" width=\"366\" height=\"248\" alt=\"\" style=\"display: block; margin-left: auto; margin-right: auto;\"&gt;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 258px;\"&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 136.823px; height: 258px;\"&gt;\n&lt;p&gt;&lt;strong&gt;4.2-&lt;/strong&gt; Dentro, coloca desde &lt;strong&gt;Registrador de datos&lt;/strong&gt; el bloque &lt;strong&gt;\u201cconfigurar columnas \u201d&lt;/strong&gt; y escribe \"luz\".&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;&amp;nbsp;&lt;/strong&gt;&lt;/p&gt;\n&lt;/td&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 193.99px; height: 258px;\"&gt;&lt;img src=\"{{context_path}}/20251125073130EABSKG/img7.png\" width=\"232\" height=\"171\" alt=\"\" style=\"display: block; margin-left: auto; margin-right: auto;\"&gt;&lt;/td&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 511.854px; height: 258px;\"&gt;&lt;img src=\"{{context_path}}/20251125073130EABSKG/img8.png\" width=\"463\" height=\"258\" alt=\"\" style=\"display: block; margin-left: auto; margin-right: auto;\"&gt;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 76px;\"&gt;\n&lt;td colspan=\"3\" style=\"border-style: double; border-color: #c8c8c8; width: 853.333px; height: 76px;\"&gt;\n&lt;h2&gt;&lt;strong&gt;PASO 5 \u2013 Bloque \u201cpara siempre\u201d&lt;/strong&gt;&lt;/h2&gt;\n&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 269px;\"&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 136.823px; height: 269px;\"&gt;\n&lt;p&gt;&lt;strong&gt;5.1-&lt;/strong&gt; En &lt;strong&gt;B\u00e1sico&lt;/strong&gt;, arrastra el bloque &lt;strong&gt;\u201cpara siempre\u201d&lt;/strong&gt;.&lt;/p&gt;\n&lt;/td&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 193.99px; height: 269px;\"&gt;&lt;img src=\"{{context_path}}/20251125073130EABSKG/img9.png\" width=\"232\" height=\"236\" alt=\"\" style=\"display: block; margin-left: auto; margin-right: auto;\"&gt;&lt;/td&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 511.854px; height: 269px;\"&gt;&lt;img src=\"{{context_path}}/20251125073130EABSKG/img10.png\" width=\"367\" height=\"269\" alt=\"\" style=\"display: block; margin-left: auto; margin-right: auto;\"&gt;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 530px;\"&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 136.823px; height: 530px;\"&gt;\n&lt;p&gt;&lt;strong&gt;5.2-&amp;nbsp;&lt;/strong&gt;Dentro a\u00f1ade:&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;1-&lt;/strong&gt;&amp;nbsp;&lt;strong&gt;Variables \u2192 fijar luz a&lt;/strong&gt; \u2192 coloca dentro el bloque &lt;strong&gt;Entrada \u2192 nivel de luz&lt;/strong&gt;.&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;2-&lt;/strong&gt;&amp;nbsp;&lt;strong&gt;Registrador de datos \u2192 registrar valor&lt;/strong&gt; con &lt;strong&gt;crear CV \"luz\" = luz&lt;/strong&gt;.&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;3-&lt;/strong&gt;&amp;nbsp;&lt;strong&gt;B\u00e1sico \u2192 mostrar n\u00famero (luz)&lt;/strong&gt;.&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;4-&lt;/strong&gt;&amp;nbsp;&lt;strong&gt;B\u00e1sico \u2192 pausa (ms) = 5000&lt;/strong&gt; (5 segundos).&lt;/p&gt;\n&lt;/td&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 193.99px; height: 530px;\"&gt;&lt;img src=\"{{context_path}}/20251125073130EABSKG/img16.1.png\" width=\"194\" height=\"224\" alt=\"\"&gt;&lt;/td&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 511.854px; height: 530px;\"&gt;&lt;img src=\"{{context_path}}/20251125073130EABSKG/img12.png\" width=\"524\" height=\"306\" alt=\"\" style=\"display: block; margin-left: auto; margin-right: auto;\"&gt;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 76px;\"&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 853.333px; height: 76px;\" colspan=\"3\"&gt;\n&lt;h2&gt;&lt;strong&gt;PASO 6 \u2013 Descargar el programa&lt;/strong&gt;&lt;strong&gt;&lt;/strong&gt;&lt;/h2&gt;\n&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 114px;\"&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 136.823px; height: 114px;\"&gt;\n&lt;p&gt;Haz clic en &lt;strong&gt;Descargar&lt;/strong&gt; en MakeCode.&lt;/p&gt;\n&lt;/td&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 711.177px; height: 114px;\" colspan=\"2\"&gt;&lt;img src=\"{{context_path}}/20251125073130EABSKG/img14.png\"&gt;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 76px;\"&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 853.333px; height: 76px;\" colspan=\"3\"&gt;\n&lt;h2&gt;&lt;strong&gt;PASO 7 \u2013 Simular el eclipse&lt;/strong&gt;&lt;/h2&gt;\n&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 497px;\"&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 136.823px; height: 497px;\"&gt;\n&lt;p&gt;&lt;strong&gt;1-&lt;/strong&gt; Desconecta el &lt;strong&gt;micro:bit&lt;/strong&gt; del ordenador y conecta las pilas.&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;2-&lt;/strong&gt; Con una linterna, tapa y destapa la luz, como si la &lt;strong&gt;Luna&lt;/strong&gt; cubriera al &lt;strong&gt;Sol&lt;/strong&gt;.&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;3-&lt;/strong&gt; Cada &lt;strong&gt;5 segundos&lt;/strong&gt;, el micro:bit mostrar\u00e1 en su pantalla el nivel de luz y lo guardar\u00e1 en el archivo &lt;strong&gt;MYDATA&lt;/strong&gt;.&lt;/p&gt;\n&lt;/td&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; height: 497px; width: 711.177px;\" colspan=\"2\"&gt;&lt;img src=\"{{context_path}}/20251125073130EABSKG/img14.1.png\" width=\"729\" height=\"410\" alt=\"\"&gt;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 71px;\"&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 853.333px; height: 71px;\" colspan=\"3\"&gt;\n&lt;h2&gt;&lt;strong&gt;PASO 8 \u2013 Analizar los datos&lt;/strong&gt;&lt;/h2&gt;\n&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 846px;\"&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 136.823px; height: 846px;\"&gt;\n&lt;p&gt;&lt;strong&gt;1-&lt;/strong&gt; Vuelve a conectar el &lt;strong&gt;micro:bit&lt;/strong&gt; al ordenador.&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;2-&lt;/strong&gt; Abre la carpeta &lt;strong&gt;MICROBIT&lt;/strong&gt; y localiza el archivo &lt;strong&gt;MYDATA&lt;/strong&gt;.&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;3-&lt;/strong&gt; Ver\u00e1s una tabla con la columna &lt;strong&gt;luz&lt;/strong&gt; y los valores registrados cada 2 segundos.&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;4-&lt;/strong&gt; Haz una gr\u00e1fica &lt;strong&gt;tiempo vs. luz&lt;/strong&gt;: observar\u00e1s c\u00f3mo los valores bajan cuando tapas la luz (valle) y suben cuando vuelve la linterna.&lt;br&gt;&lt;br&gt;&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;5- Prueba&lt;/strong&gt; con una &lt;strong&gt;l\u00e1mpara&lt;/strong&gt; diferente y &lt;strong&gt;compara la gr\u00e1fica&lt;/strong&gt;.&lt;/p&gt;\n&lt;p&gt;&lt;strong&gt;6-&lt;/strong&gt;Si te sobra tiempo, &lt;strong&gt;introduce un sonido&lt;/strong&gt; cuando ocurra el &lt;strong&gt;\u201ceclipse\u201d&lt;/strong&gt; (luz=0).&lt;/p&gt;\n&lt;/td&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; height: 846px;\" colspan=\"2\"&gt;&lt;img src=\"{{context_path}}/20251125073130EABSKG/img15.png\" width=\"729\" height=\"153\" alt=\"\"&gt;&lt;br&gt;&lt;img src=\"{{context_path}}/20251125073130EABSKG/img16.png\" width=\"176\" height=\"517\" alt=\"\"&gt;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8;\" colspan=\"3\"&gt;\ud83d\udca1 &lt;strong data-start=\"46\" data-end=\"58\"&gt;Consejo:&lt;/strong&gt; Puedes usar una hoja de c\u00e1lculo (por ejemplo, &lt;strong data-start=\"105\" data-end=\"114\"&gt;Excel&lt;/strong&gt;, &lt;strong data-start=\"116\" data-end=\"133\"&gt;Google Sheets&lt;/strong&gt; o &lt;strong data-start=\"136\" data-end=\"144\"&gt;Calc&lt;/strong&gt;) para &lt;strong data-start=\"151\" data-end=\"203\"&gt;tratar los datos y crear los gr\u00e1ficos f\u00e1cilmente&lt;/strong&gt;.&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr&gt;\n&lt;td style=\"border-style: double; border-color: #c8c8c8; width: 136.823px;\" colspan=\"3\"&gt;&lt;img src=\"{{context_path}}/20251125073130EABSKG/LibreOffice-Calc.png\" alt=\"\" width=\"1368\" height=\"727\"&gt;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;/tbody&gt;\n&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;&lt;/div&gt;","textFeedbackInput":"","textFeedbackTextarea":""}</jsonProperties><odeComponentsOrder>1</odeComponentsOrder><odeComponentsProperties><odeComponentsProperty><key>visibility</key><value>true</value></odeComponentsProperty><odeComponentsProperty><key>teacherOnly</key><value>false</value></odeComponentsProperty><odeComponentsProperty><key>identifier</key><value/></odeComponentsProperty><odeComponentsProperty><key>cssClass</key><value/></odeComponentsProperty></odeComponentsProperties></odeComponent></odeComponents></odePagStructure></odePagStructures></odeNavStructure></odeNavStructures></ode>
